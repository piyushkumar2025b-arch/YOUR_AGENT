# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OpenRouter API Key for multi-model AI routing (optional; can also be provided in UI)
OPENROUTER_API_KEY=""

# GitHub OAuth Credentials
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# YouTube Data API v3 Key for YouTube Agent (Search, Video Stats, Comments)
YOUTUBE_API_KEY=""

# Cryptographic Session Secret for user authentication tokens (optional; auto-persisted if omitted)
SESSION_SECRET=""

# Persistent User Database Path (optional; defaults to .data/app_auth_users.json)
USERS_DB_PATH=""

# Firebase Client Configuration (Optional overrides for production)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""
